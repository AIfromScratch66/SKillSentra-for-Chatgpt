# Copy to .env.chatgpt-mcp for Docker Compose interpolation; the real file is gitignored.
# Generate two different high-entropy values. Never reuse either token elsewhere.
SKILLSENTRA_CHATGPT_MCP_AUTH_TOKEN=replace-with-a-dedicated-gateway-secret
# This value must also be a token key with appropriate roles in the SkillSentra
# service's SKILLSENTRA_AUTH_TOKENS_JSON, but it must differ from the gateway secret.
SKILLSENTRA_API_TOKEN=replace-with-a-different-skillsentra-service-token
# Optional exact browser origin. Server-to-server clients normally send no Origin.
SKILLSENTRA_CHATGPT_ALLOWED_ORIGINS=https://chatgpt.com
