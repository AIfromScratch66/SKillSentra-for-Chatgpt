# SkillSentra stores only these environment-variable names in SQLite.
# Never put real keys in frontend code or commit a populated .env file.
SKILLSENTRA_OPENAI_API_KEY=
SKILLSENTRA_CUSTOM_API_KEY=
SKILLSENTRA_HOST=127.0.0.1
SKILLSENTRA_PORT=8766
# ChatGPT MCP gateway. Loopback is the safe development default.
SKILLSENTRA_CHATGPT_MCP_HOST=127.0.0.1
SKILLSENTRA_CHATGPT_MCP_PORT=8787
# Comma-separated exact HTTP(S) origins. Empty permits requests without an Origin header only.
SKILLSENTRA_CHATGPT_ALLOWED_ORIGINS=
# Incoming ChatGPT/MCP-client secret. Generate a high-entropy value; do not reuse the service token.
SKILLSENTRA_CHATGPT_MCP_AUTH_TOKEN=
# Anonymous mode is an explicit protocol-testing exception and works only on loopback.
SKILLSENTRA_CHATGPT_ALLOW_ANONYMOUS_LOOPBACK=false
# Separate SkillSentra service token used by the gateway for upstream API calls.
SKILLSENTRA_API_TOKEN=
# Google OAuth uses the authorization-code flow. Configure the same callback URI in Google Cloud.
# The redirect URI must end with /api/v1/auth/google/callback; keep these values server-side only.
SKILLSENTRA_GOOGLE_CLIENT_ID=
SKILLSENTRA_GOOGLE_CLIENT_SECRET=
SKILLSENTRA_GOOGLE_REDIRECT_URI=
# ChatGPT OAuth is opt-in and requires approved external application credentials.
# The server uses authorization code + PKCE and does not persist access tokens.
SKILLSENTRA_CHATGPT_ENABLED=false
SKILLSENTRA_CHATGPT_CLIENT_ID=
SKILLSENTRA_CHATGPT_CLIENT_SECRET=
SKILLSENTRA_CHATGPT_AUTHORIZATION_URL=
SKILLSENTRA_CHATGPT_TOKEN_URL=
SKILLSENTRA_CHATGPT_USERINFO_URL=
SKILLSENTRA_CHATGPT_REDIRECT_URI=
SKILLSENTRA_CHATGPT_SCOPE=openid email profile
# Production-only account lifecycle settings (STARTTLS is mandatory).
# SKILLSENTRA_REQUIRE_EMAIL_VERIFICATION=true
# SKILLSENTRA_SMTP_HOST=smtp.example.com
# SKILLSENTRA_SMTP_PORT=587
# SKILLSENTRA_SMTP_USERNAME=
# SKILLSENTRA_SMTP_PASSWORD=
# SKILLSENTRA_SMTP_FROM=noreply@example.com
# SKILLSENTRA_SMTP_STARTTLS=true
# SKILLSENTRA_DATABASE_PATH=C:\path\to\skillsentra.db
# SKILLSENTRA_ARTIFACT_DIR=C:\path\to\isolated-artifacts
# Separate multiple allowed roots with a semicolon on Windows.
# SKILLSENTRA_ALLOWED_SKILL_ROOTS=C:\skills\team;C:\skills\personal
SKILLSENTRA_PRICEBOOK_VERSION=local-pricebook-v1
SKILLSENTRA_PRICEBOOK_CURRENCY=USD
# JSON map of model prefixes to input/output price per million tokens.
# SKILLSENTRA_MODEL_PRICES_JSON={"gpt-":{"input_per_million":2,"output_per_million":8}}
