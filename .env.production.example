# Copy this file to .env.production and replace every example value.
SKILLSENTRA_ENV=production
SKILLSENTRA_AUTH_MODE=hybrid
SKILLSENTRA_AUTH_TOKENS_JSON={"replace-with-at-least-24-random-characters":{"tenant_id":"ten_example","actor_id":"admin@example","roles":["admin","operator","security","finance"]}}
SKILLSENTRA_PASSWORD_PEPPER=replace-with-a-high-entropy-secret
SKILLSENTRA_SESSION_DAYS=7
SKILLSENTRA_TRUSTED_ORIGINS=https://skillsentra.example.com
SKILLSENTRA_PUBLIC_ORIGIN=https://skillsentra.example.com
SKILLSENTRA_REQUIRE_EMAIL_VERIFICATION=true
SKILLSENTRA_TLS_TERMINATION_CONFIRMED=false
SKILLSENTRA_BACKUP_VERIFIED=false
SKILLSENTRA_OBSERVABILITY_ENDPOINT=
SKILLSENTRA_RATE_LIMIT_PER_MINUTE=240
SKILLSENTRA_MAX_WORKERS=64
SKILLSENTRA_LOG_LEVEL=INFO
SKILLSENTRA_AUTOMATION_ENABLED=true
SKILLSENTRA_AUTOMATION_POLL_SECONDS=60
# Local demo catalog only. Keep false in production and curate real listings through operations.
SKILLSENTRA_DEMO_SEED=false

# Optional Google OAuth authorization-code login. Register the exact callback URL in Google Cloud.
SKILLSENTRA_GOOGLE_CLIENT_ID=
SKILLSENTRA_GOOGLE_CLIENT_SECRET=
SKILLSENTRA_GOOGLE_REDIRECT_URI=https://skillsentra.example.com/api/v1/auth/google/callback
SKILLSENTRA_GOOGLE_SSO_VERIFIED=false

# Account lifecycle email delivery. STARTTLS is mandatory; inject the password
# through the deployment secret manager rather than committing it.
SKILLSENTRA_SMTP_HOST=
SKILLSENTRA_SMTP_PORT=587
SKILLSENTRA_SMTP_USERNAME=
SKILLSENTRA_SMTP_PASSWORD=
SKILLSENTRA_SMTP_FROM=
SKILLSENTRA_SMTP_STARTTLS=true

# Optional GitHub App installation token or fine-grained read-only token.
# Prefer a short-lived installation token injected by the deployment platform.
SKILLSENTRA_GITHUB_TOKEN=
# Each GitHub attempt is bounded; only transient failures are retried with exponential backoff.
SKILLSENTRA_GITHUB_TIMEOUT_SECONDS=10
SKILLSENTRA_GITHUB_MAX_ATTEMPTS=2
SKILLSENTRA_GITHUB_RETRY_BASE_SECONDS=0.25
# Includes network attempts and retry delays; stays below the browser's 12-second request window.
SKILLSENTRA_GITHUB_TOTAL_BUDGET_SECONDS=11

# Sign in with ChatGPT remains disabled until OpenAI external-application approval,
# official credentials, an approved callback, and a reviewed server-side integration
# are all present. The adapter uses authorization code + PKCE and never stores tokens.
SKILLSENTRA_CHATGPT_ENABLED=false
SKILLSENTRA_CHATGPT_CLIENT_ID=
SKILLSENTRA_CHATGPT_CLIENT_SECRET=
SKILLSENTRA_CHATGPT_AUTHORIZATION_URL=
SKILLSENTRA_CHATGPT_TOKEN_URL=
SKILLSENTRA_CHATGPT_USERINFO_URL=
SKILLSENTRA_CHATGPT_REDIRECT_URI=https://skillsentra.example.com/api/v1/auth/chatgpt/callback
SKILLSENTRA_CHATGPT_SCOPE=openid email profile
SKILLSENTRA_CHATGPT_APPROVED=false

# Optional AI connection. The browser never receives this value.
SKILLSENTRA_OPENAI_API_KEY=
SKILLSENTRA_ALLOWED_CREDENTIAL_ENVS=SKILLSENTRA_OPENAI_API_KEY

# Maintain these values against the supplier invoice used by your organization.
SKILLSENTRA_PRICEBOOK_VERSION=team-pricebook-2026-08
SKILLSENTRA_PRICEBOOK_CURRENCY=USD
